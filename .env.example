# Firebase Web App configuration.
# These values identify your Firebase project; Firestore Security Rules and
# Firebase Authentication protect the data. Never put a service-account key
# or GitHub personal access token in this file.
VITE_FIREBASE_API_KEY=replace_with_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace_with_firebase_app_id

# Optional values shown in Firebase's Web App configuration.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
